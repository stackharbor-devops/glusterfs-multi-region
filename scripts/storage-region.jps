type: install
version: 1.0
id: glusterfs-storage-region
name: GlusterFS Storage Region
baseUrl: https://raw.githubusercontent.com/stackharbor-devops/glusterfs-multi-region/main
description:
  short: A single-region GlusterFS cluster on Jelastic Certified Storage nodes.

# ---------------------------------------------------------------------------
# This is the per-region child environment. The top-level manifest.jps installs
# it once per selected region (region-pinned via the `region:` install param)
# and passes the volume parameters down through `settings`.
#
# Node foundation: Jelastic Certified Storage (nodeType: storage). glusterd ships
# preinstalled on this image, so there is nothing to yum/apt-install here.
# ---------------------------------------------------------------------------

globals:
  replicatedVolume: ${settings.volumeName:data}
  replicatedPath: ${settings.mountPoint:/data}
  replicaCount: ${settings.replicaCount:3}
  replicationModel: ${settings.replicationModel:sync}

nodes:
  - nodeType: storage
    nodeGroup: storage
    count: ${settings.nodes:3}
    # cluster: false -> do NOT use Jelastic's built-in Shared-Storage auto-clustering
    # (which always makes a pure replica = node-count volume per region). Our
    # cluster-logic / syncClusterManager owns the volume instead, so we get
    # distributed-replicated slicing (async) and the stretched volume (sync).
    #
    # The layer is still presented to the dashboard as a storage cluster - see
    # enableNativeFuse below - but without the built-in package ever running.
    cluster: false
    fixedCloudlets: 1
    flexibleCloudlets: 8
    displayName: GlusterFS Storage

onInstall:
  # Cross-region replication runs over the platform's internal GRE routing —
  # no public IPs are allocated to storage nodes.
  - installClusterLogic
  - enableNativeFuse

actions:
  # Install the permanent in-region cluster logic (volume create / mount / scale).
  installClusterLogic:
    install:
      jps: ${baseUrl}/scripts/cluster-logic.jps?_r=${fn.random}
      settings:
        nodeGroup: storage
        replicatedVolume: ${globals.replicatedVolume}
        replicatedPath: ${globals.replicatedPath}
        replicaCount: ${globals.replicaCount}
        replicationModel: ${globals.replicationModel}

  # Flag the layer as a storage cluster in node-group data, so other envs'
  # Volumes -> Data Container dialog lists it as "Storage Containers x N" and
  # offers the Gluster Native (FUSE) client type - region-level mounts with
  # nothing installed on the client env. Metadata only: it does not touch
  # gluster. strict=false -> it can never fail the storage deployment.
  enableNativeFuse:
    install:
      jps: ${baseUrl}/addons/native-fuse.jps?_r=${fn.random}
      settings:
        nodeGroup: storage
        replicatedVolume: ${globals.replicatedVolume}
        replicatedPath: ${globals.replicatedPath}
        strict: false
