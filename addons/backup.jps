type: update
jpsVersion: 6.1.1
version: 2.0
id: glusterfs-restic-backup
name: GlusterFS Backup/Restore
targetEditions: any
logo: https://raw.githubusercontent.com/jelastic-jps/backup-storage/main/images/backup-logo.svg
baseUrl: https://raw.githubusercontent.com/stackharbor-devops/glusterfs-multi-region/main
description:
  short: Scheduled restic backups of the multi-region GlusterFS volume to a Backup Storage environment, with restore.
  text: |
    Backs up the multi-region GlusterFS volume with restic to a Jelastic
    "Backup Storage" environment. Install it on the storage layer of the
    GlusterFS region environment that is in the same region as the backup
    storage. The volume is synchronously replicated, so ONE node holds the
    whole dataset: backups run from that region's lowest-id secondary storage
    node (the master when the region has a single node).

    Backups are scheduled by the platform, so every run appears in the Tasks
    log. A manual backup queues behind a running one instead of failing;
    a restore is never queued, and is never interrupted by Uninstall.
    Uninstalling the add-on leaves the cluster and the backup repository
    untouched; install it again at any time to resume. Delete All Backups
    (in the card's menu) clears this cluster's repository.

    Repository layout follows the Jelastic backup-storage convention:
    /data/<envName>/ on the storage, password = the environment name.

# ---------------------------------------------------------------------------
# Structure (v2)
#
# This manifest IS the add-on card: top-level buttons/menu, no `addons:`
# section and no `permanent`, installed on the storage layer (manifest.jps
# passes nodeGroup: storage). That is what gives the card an Uninstall entry
# - the v1 add-on bound a permanent inner card and could not be removed.
#
#   scripts/backup/manage.js          install / Configure / buttons (uninstall is inline below)
#   scripts/backup/backup-task.js     per-env platform script "<env>-gfs-backup",
#                                      run by the platform scheduler and by the
#                                      buttons; one ExecCmd per run = one Tasks entry
#   scripts/backup/glusterfs-backup.sh  node-side runner (restic, locking,
#                                      detached jobs, retention)
#   scripts/backup/settings-form.js   Configure / install form
#   scripts/backup/restore-form.js    Restore form (snapshot list)
#
# The configuration is kept in the storage node group's data under the key
# "gfsBackup" - never under "globals", which holds the cluster parameters the
# day-2 add-ons read back (v1 overwrote them when the backup env was -1).
# ---------------------------------------------------------------------------

targetNodes:
  nodeGroup: storage
  nodeType:
    - storage

globals:
  # ${baseUrl} is captured once at install time; actions reached from the
  # card's buttons use ${globals.base_path}.
  base_path: ${baseUrl}
  backupReport: ""

# Install dialog (Import): fills the Backup Storage and time-zone lists.
onBeforeInit: scripts/backup/settings-form.js

settings:
  main:
    # Save is enabled even when nothing was changed: re-saving re-creates the
    # task script, the schedule and the node setup.
    submitUnchanged: true
    onBeforeInit: scripts/backup/settings-form.js
    fields:
      - type: displayfield
        hideLabel: true
        cls: info
        height: 40
        markup: "Backups are started by the platform scheduler (times in UTC) on one secondary storage node of this region; every run appears in the Tasks log."
      - type: radio-fieldset
        name: scheduleType
        default: "1"
        values:
          - value: "1"
            caption: Pre-defined
          - value: "2"
            caption: Custom
          - value: "3"
            caption: Manual (cron)
        showIf:
          "1":
            - type: list
              name: cronTime
              caption: Frequency
              editable: false
              default: "0 * * * *"
              values:
                - value: "*/5 * * * *"
                  caption: Every 5 minutes
                - value: "*/10 * * * *"
                  caption: Every 10 minutes
                - value: "*/15 * * * *"
                  caption: Every 15 minutes
                - value: "*/30 * * * *"
                  caption: Every 30 minutes
                - value: "0 * * * *"
                  caption: Hourly (at minute 0)
                - value: "0 */2 * * *"
                  caption: Every 2 hours
                - value: "0 */3 * * *"
                  caption: Every 3 hours
                - value: "0 */6 * * *"
                  caption: Every 6 hours
                - value: "0 */12 * * *"
                  caption: Every 12 hours
                - value: "0 0 * * *"
                  caption: Daily (00:00 UTC)
                - value: "0 0 * * 0"
                  caption: Weekly (Sunday 00:00 UTC)
          "2":
            - type: string
              name: backupTime
              caption: Time
              inputType: time
              default: "02:00"
              cls: x-form-text
              width: 120
              required: true
            - type: compositefield
              name: days
              caption: Days
              defaultMargins: 0 12 0 0
              items:
                - name: sun
                  type: checkbox
                  caption: Su
                  value: false
                - name: mon
                  type: checkbox
                  caption: Mo
                  value: true
                - name: tue
                  type: checkbox
                  caption: Tu
                  value: true
                - name: wed
                  type: checkbox
                  caption: We
                  value: true
                - name: thu
                  type: checkbox
                  caption: Th
                  value: true
                - name: fri
                  type: checkbox
                  caption: Fr
                  value: true
                - name: sat
                  type: checkbox
                  caption: Sa
                  value: false
            - type: list
              name: tz
              caption: Time zone
              required: true
              editable: true
              forceSelection: true
              default: UTC
              values:
                - value: UTC
                  caption: UTC
          "3":
            - type: string
              name: cronTime
              caption: Cron (UTC)
              default: "0 2 * * *"
              required: true
              regex: "^[0-9A-Za-z*/,-]+( +[0-9A-Za-z*/,-]+){4}$"
              regexText: "Five fields: minute hour day-of-month month day-of-week, in UTC."
      - type: list
        name: storageName
        caption: Backup storage
        tooltip: The Backup Storage environment that holds the snapshots. It should be in the same region as this environment.
        required: true
        editable: false
        forceSelection: true
        values: []
      - type: string
        name: sourcePath
        caption: Volume mount path
        tooltip: Where the GlusterFS volume is FUSE-mounted on the storage nodes.
        default: /data
        required: true
        regex: "^/[A-Za-z0-9._/-]*[A-Za-z0-9_-]$"
        regexText: An absolute path such as /data.
      - type: spinner
        name: backupCount
        caption: Snapshots to keep
        min: 1
        max: 1000
        default: 24
      - type: toggle
        name: notifyOnFailure
        caption: E-mail me when a scheduled backup fails
        value: true

  restore:
    fields: []
    onBeforeInit: scripts/backup/restore-form.js

  purge:
    fields: []
    onBeforeInit: |
      settings.fields = [
        { type: "displayfield", cls: "warning", hideLabel: true, height: 80,
          markup: "This permanently deletes EVERY snapshot of ${env.envName} from its backup storage. The cluster and its data are not touched, and the next backup starts a new repository." },
        { type: "string", name: "confirm", caption: "Type ${env.envName}", required: true,
          regex: "^${env.envName}$", regexText: "Type the environment name exactly.", initialValue: "" }
      ];
      return settings;

buttons:
  - caption: Backup Now
    action: backupNow
    confirmText: Start a backup now? If a backup is already running, this one starts as soon as it finishes.
    loadingText: Backing up...
    successText: Backup completed. The snapshot details are in the Tasks log (the "Executing command" entry for the storage node).
  - caption: Configure
    action: configure
    settings: main
    submitUnchanged: true
    submitButtonText: Save
    loadingText: Checking the node and the backup storage...
    successText: Backup configuration saved and the schedule updated.
  - caption: Restore
    action: restore
    settings: restore
    title: Restore Backup
    submitButtonText: Restore
    confirmText: Restore the selected snapshot? Existing files at the target are overwritten and the change replicates to every region. If another backup job is running, the restore is not started.
    loadingText: Restoring...
    successText: Restore completed. Details are in the Tasks log.
  - caption: Verify
    action: verify
    confirmText: Check the backup repository's integrity? This reads back 5% of the stored data.
    loadingText: Verifying...
    successText: Repository check passed. Details are in the Tasks log.

menu:
  - caption: Backup Status
    action: status
    confirmText: Show the backup status of this cluster?
    loadingText: Reading the backup status...
  - caption: Delete All Backups
    action: purge
    settings: purge
    title: Delete All Backups
    submitButtonText: Delete
    confirmText: Permanently delete every snapshot of this cluster from the backup storage? This cannot be undone.
    loadingText: Deleting...
    successText: All backups were deleted. The next backup starts a new repository.

onInstall:
  - manage:
      op: apply
      phase: install

# Uninstall runs inline on purpose: it must work even when the package's
# scripts cannot be downloaded, and a failing step would make the card
# impossible to remove. It only refuses while a restore is writing into the
# volume. The backup repository on the backup storage is kept.
onUninstall:
  - script: |
      var env = "${env.envName}", envAppid = "${env.appid}", name = env + "-gfs-backup", cfgStr = "", i, j, a, r, t, d, g;
      function unwrap(x) { return (x && x.response && typeof x.response === "object" && x.response.result !== undefined) ? x.response : x; }
      function evalTask(p) { try { return unwrap(jelastic.dev.scripting.Eval(appid, session, name, p)); } catch (e) { return null; } }

      // 1) Never stop a restore halfway (the live volume would be left partly restored).
      var probe = evalTask({ job: "probe", envName: env });
      if (probe && probe.result === 0 && probe.restoreRunning) {
        return { result: 99, error: String(probe.message), message: String(probe.message), type: "error" };
      }

      // 2) No new scheduled runs.
      var seen = {}, ids = [appid, envAppid];
      for (i = 0; i < ids.length; i++) {
        a = ids[i];
        if (!a || seen[a]) continue;
        seen[a] = true;
        try { r = jelastic.utils.scheduler.GetTasks(a, session); } catch (e) { continue; }
        t = (r && r.result == 0) ? (r.objects || r.array || []) : [];
        for (j = 0; j < t.length; j++) {
          if (String(t[j].script) != name) continue;
          try { d = jelastic.utils.scheduler.RemoveTask(a, session, t[j].id); } catch (e) { d = null; }
          if (!d || d.result != 0) { try { jelastic.utils.scheduler.DeleteTasks({ appid: a, session: session, ids: String(t[j].id) }); } catch (e) {} }
        }
      }

      // 3) Clear the configuration (a run already in flight then does nothing),
      //    keeping a copy for the node cleanup.
      try {
        r = jelastic.env.control.GetNodeGroups(env, session);
        for (i = 0; r && r.result == 0 && i < r.object.length; i++) {
          if (String(r.object[i].name) == "storage" && r.object[i].gfsBackup) cfgStr = String(r.object[i].gfsBackup);
        }
      } catch (e) {}
      try {
        r = jelastic.env.control.ApplyNodeGroupData(env, session, "storage", toJSON({ gfsBackup: "" }));
        if (!r || r.result != 0) jelastic.env.control.ApplyNodeGroupData(env, session, "storage", { gfsBackup: "" });
      } catch (e) {}

      // 4) Stop jobs, remove the runner, mounts and v1 leftovers from the nodes.
      //    A restore that started after step 1 keeps its node untouched; the
      //    card stays so a later Uninstall removes what is left.
      var rm = evalTask({ job: "remove", envName: env, config: cfgStr });
      if (rm && rm.result === 0 && rm.restoreRunning) {
        var msg = String(rm.message) + " The backup schedule was already removed. Uninstall again once the restore has finished; that removes the rest and the add-on.";
        return { result: 99, error: msg, message: msg, type: "error" };
      }

      // 5) The task script itself.
      try {
        g = jelastic.dev.scripting.GetScript(appid, session, name);
        if (g && g.result == 0) jelastic.dev.scripting.DeleteScript(appid, session, name);
      } catch (e) {}
      return { result: 0 };

# Environment deletion: the platform removes the scheduler tasks with the
# environment; the platform script has to be deleted explicitly.
onBeforeDelete:
  - script: |
      var name = "${env.envName}-gfs-backup", g;
      try {
        g = jelastic.dev.scripting.GetScript(appid, session, name);
        if (g && g.result == 0) jelastic.dev.scripting.DeleteScript(appid, session, name);
      } catch (e) {}
      return { result: 0 };

onAfterConfirmTransfer:
  - manage:
      op: transfer

actions:
  manage:
    - script: ${globals.base_path}/scripts/backup/manage.js?_r=${fn.random}
      params:
        op: ${this.op}
        phase: ${this.phase}
        job: ${this.job}
        snapshotId: ${this.snapshotId}
        restorePath: ${this.restorePath}
        confirm: ${this.confirm}
        envName: ${env.envName}
        envAppid: ${env.appid}
        basePath: ${globals.base_path}
        scheduleType: ${settings.scheduleType}
        cronTime: ${settings.cronTime}
        backupTime: ${settings.backupTime}
        tz: ${settings.tz}
        sun: ${settings.sun}
        mon: ${settings.mon}
        tue: ${settings.tue}
        wed: ${settings.wed}
        thu: ${settings.thu}
        fri: ${settings.fri}
        sat: ${settings.sat}
        storageName: ${settings.storageName}
        sourcePath: ${settings.sourcePath}
        backupCount: ${settings.backupCount}
        notifyOnFailure: ${settings.notifyOnFailure}
        cluster_id: ${settings.cluster_id}
        primary_region_name: ${settings.primary_region_name}
        backup_region_name: ${settings.backup_region_name}
        volume_name: ${settings.volume_name}

  configure:
    - manage:
        op: apply
        phase: configure

  backupNow:
    - manage:
        op: run
        job: backup

  verify:
    - manage:
        op: run
        job: verify

  status:
    - manage:
        op: run
        job: status

  restore:
    - manage:
        op: run
        job: restore
        snapshotId: ${settings.snapshotId}
        restorePath: ${settings.restorePath}

  purge:
    - manage:
        op: run
        job: purge
        confirm: ${settings.confirm}

success: |
  **GlusterFS backups are configured.**

  ${globals.backupReport}

  Every scheduled run appears in the Tasks log as an *Executing command* entry for the storage node. The card on the storage layer has **Backup Now**, **Configure**, **Restore** and **Verify**; its menu has **Backup Status**, **Delete All Backups** and **Uninstall**.
